# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta WhatsApp Cloud API
META_WHATSAPP_ACCESS_TOKEN=your-meta-graph-api-token
META_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
META_WHATSAPP_WABA_ID=your-waba-account-id
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-custom-verify-token

# Email Sending (Resend / AWS SES)
RESEND_API_KEY=re_your_resend_api_key
DEFAULT_FROM_EMAIL=notifications@yourdomain.com

# Redis / BullMQ (for production queue workers)
REDIS_URL=redis://localhost:6379
